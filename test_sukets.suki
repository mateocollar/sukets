#include <fundamental.huki>
#include "sukets.huki"

fn main() -> void {
    printf("[SUKETS] Iniciando prueba de cliente TCP...\n");
    
    var sock: int = sukets_connect("127.0.0.1", 8080);
    if (sock < 0) {
        printf("[SUKETS] Error al conectar. Codigo: %d\n", sock);
        return;
    }
    
    printf("[SUKETS] ¡Conectado exitosamente con descriptor: %d!\n", sock);
    
    var mensaje: char* = "Hola desde itsuki-lang con sukets!\n";
    var bytes_enviados: int = sukets_send(sock, mensaje, 36);
    printf("[SUKETS] Bytes enviados: %d\n", bytes_enviados);
    
    // Buffer para recibir respuesta
    var buffer: char[256];
    var bytes_recibidos: int = sukets_recv(sock, buffer, 256);
    
    if (bytes_recibidos > 0) {
        printf("[SUKETS] Respuesta del servidor recibida.\n");
    }
    
    sukets_close(sock);
    printf("[SUKETS] Socket cerrado correctamente.\n");
}